# Copy to .env and fill in. Values here are defaults compiled into BuildConfig by the
# Secrets Gradle Plugin. Never commit your real .env.

# --- Meta Model API (RideStory AI Studio) — https://dev.meta.ai/docs ---
# OpenAI-compatible chat completions. Leave the key empty to run the Studio fully on-device
# (scoring, rendering and template stories still work; AI labelling/writing is disabled).
MODEL_API_KEY=MY_MODEL_API_KEY
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_TEXT=muse-spark-1.3
MODEL_VISION=muse-spark-1.3
# Any OpenAI-compatible host serving Meta open-weights models also works, e.g. Fireworks:
# MODEL_API_BASE_URL=https://api.fireworks.ai/inference/v1

# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY
